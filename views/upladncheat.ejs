<h3>Hile Yükle</h3>
<form action="/add-cheat2" method="POST" enctype="multipart/form-data">
    <label>Kategori Seç:</label>
    <select name="categoryId" required>
        <% games.forEach(game => { %>
            <option value="<%= game._id %>"><%= game.GameName %></option>
        <% }) %>
    </select>
    <input type="text" name="name" placeholder="Saat Adı" required>
    <br>
    <input type="number" name="caliber" placeholder="Milimetresi" required><br>
    <input type="number" name="referenceNumber" placeholder="referans No" required><br>
    <input type="text" name="caseMaterial" placeholder="Case Material" required><br>
    <input type="text" name="price" placeholder="Fiyat (örn: 7.99)" required><br>
    <textarea name="aciklama" placeholder="acıklama" rows="4" required><br>
    <label>Kapak Resmi:</label>
    <input type="file" name="coverImage" required><br>
    <label>Alt Resimler (Max 5):</label>
    <input type="file" name="otherImages" multiple>
    
    <button type="submit">Hileyi Kaydet</button>
</form>