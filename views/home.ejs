<div class="storeCont">
    <div class="storeLeft">
        <div class="box products">
            <h3>Rolex Database Archive</h3>
            <div class="products-grid">
                
                <% if (typeof watches !== 'undefined' && watches.length > 0) { %>
                    <% watches.forEach(watch => { %>
                        <div class="featured">
                            <img src="/proxy-watch-image?watchId=<%= watch.watchId %>&imageName=<%= watch.watchImageName %>" 
                                 alt="<%= watch.makeName %> <%= watch.modelName %>" 
                                 onerror="this.onerror=null; this.src='https://placehold.co/400x600/141414/888888?text=Image+Not+Found';">

                            <div class="featuredInfo">
                                <div class="namePrice">
                                    <h4 class="name"><%= watch.makeName %> <%= watch.familyName %></h4>
                                    <div class="price greentxt">
                                        <%= watch.priceInEuro ? '€' + watch.priceInEuro : 'POA' %>
                                    </div>
                                </div>
                                
                                <div class="subInfo">
                                    <span class="textNav"><i class="fa-solid fa-hashtag"></i> Ref: <%= watch.reference || 'Unknown' %></span>
                                    <span class="textNav"><i class="fa-solid fa-gear"></i> <%= watch.movementName || 'Caliber unlisted' %></span>
                                </div>
                            </div>
                        </div> <% }) %>
                <% } else { %>
                    <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No reference data loaded from the RapidAPI node.</p>
                <% } %>
                
            </div>
        </div>
    </div>

    <div class="storeRight">
        <div class="box Categories">
            <h3>Market Segments</h3>
            <ul>
                <li class="li"><a href="#"><span></span>Rolex</a></li>
                <li class="li"><a href="#"><span></span>Patek Philippe</a></li>
                <li class="li"><a href="#"><span></span>Audemars Piguet</a></li>
                <li class="li"><a href="#"><span></span>A. Lange & Söhne</a></li>
                <li class="li"><a href="#"><span></span>Vacheron Constantin</a></li>
            </ul>
        </div>
    </div>
</div>